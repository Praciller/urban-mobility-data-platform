FROM python:3.12-slim AS demo-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    DATA_DIR=/data \
    DUCKDB_PATH=/data/processed/urban_mobility.duckdb \
    RUN_ID=render-demo-build

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY apps/api ./apps/api
COPY dbt ./dbt
COPY scripts ./scripts

RUN python -m pip install --no-cache-dir uv==0.11.21 \
    && uv sync --locked --all-groups \
    && uv run python scripts/run_demo.py --data-dir /data --duckdb-path /data/processed/urban_mobility.duckdb --year 2026 --month 1 --service yellow --sample-rows 1000 --run-id render-demo-build

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    DATA_DIR=/data \
    DUCKDB_PATH=/data/processed/urban_mobility.duckdb \
    API_HOST=0.0.0.0

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY apps/api ./apps/api
RUN python -m pip install --no-cache-dir uv==0.11.21 \
    && uv sync --locked --no-dev --no-editable
COPY --from=demo-builder /data /data

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "exec /app/.venv/bin/uvicorn apps.api.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
